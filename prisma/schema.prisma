// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output        = "../src/generated/prisma"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "mysql"

}


// ======================================================
// ENUMS
// ======================================================

enum UserStatus {
  PENDING
  ACTIVE
  BANNED
  DELETED
}

enum ActionType {
  CREATE
  UPDATE
  DELETE
  BAN
  RESTORE
  LOGIN
  LOGOUT
}

enum TokenType {
  ACCESS
  REFRESH
}

enum RoleCode {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CUSTOMER
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

// ======================================================
// ROLE
// ======================================================

model Role {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(100)
  description String?   @db.Text
  isSystem    Boolean   @default(false) @map("is_system")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

// ======================================================
// USER
// ======================================================

model User {
  id               String       @id @default(uuid())

  email            String       @unique @db.VarChar(255)
  password         String?      @db.VarChar(255)

  fullName         String       @map("full_name") @db.VarChar(100)
  phone            String?      @unique @db.VarChar(20)
  avatar           String?      @db.Text

  emailVerifiedAt  DateTime?    @map("email_verified_at")
  lastLoginAt      DateTime?    @map("last_login_at")

  status           UserStatus   @default(PENDING)

  // Role
  roleId           Int          @map("role_id")
  role             Role         @relation(fields: [roleId], references: [id])

  // Audit fields
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")
  deletedBy        String?      @map("deleted_by")

  // Relations
  sessions         Session[]
  actionsPerformed ActionLog[]  @relation("ActionPerformedBy")


  //OAuth2.0
  provider        AuthProvider @default(LOCAL)
  providerId      String?      @map("provider_id") @db.VarChar(255)

  @@unique([provider, providerId]) // Ngăn chặn trùng ID

  // Indexes
  @@index([roleId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([providerId])

  @@map("users")
}

// ======================================================
// SESSION
// ======================================================

model Session {
  id               String     @id @default(uuid())

  userId           String     @map("user_id")
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // JWT data
  jti              String     @unique
  refreshTokenHash String     @map("refresh_token_hash") @db.VarChar(255)

  tokenVersion     Int        @default(1) @map("token_version")

  // Device info
  deviceName       String?    @map("device_name") @db.VarChar(255)
  deviceIp         String?    @map("device_ip") @db.VarChar(45)
  userAgent        String?    @map("user_agent") @db.Text

  // Status
  revokedAt        DateTime?  @map("revoked_at")
  revokedReason    String?    @map("revoked_reason") @db.VarChar(255)

  // Expiration
  expiresAt        DateTime   @map("expires_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  // Indexes
  @@index([userId])
  @@index([jti])
  @@index([expiresAt])
  @@index([revokedAt])

  @@map("sessions")
}

// ======================================================
// ACTION LOG
// ======================================================

model ActionLog {
  id         String   @id @default(uuid())

  action     ActionType
  entityName String   @map("entity_name") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.VarChar(255)

  adminId    String?  @map("admin_id")
  admin      User?    @relation("ActionPerformedBy", fields: [adminId], references: [id], onDelete: SetNull)

  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")

  reason     String?  @db.Text
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text

  createdAt  DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([entityName, entityId])
  @@index([action])
  @@index([createdAt])

  @@map("action_logs")
}


model Permission {
  id          String   @id @default(uuid())

  name        String   @db.VarChar(100)   
  apiPath     String   @map("api_path") @db.VarChar(255) 
  method      HttpMethod                   
  module      String   @db.VarChar(100)  
  roles       RolePermission[]

  @@unique([apiPath, method])   // Không duplicate cùng route+method
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId        Int        @map("role_id")
  permissionId  String     @map("permission_id")

  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt    DateTime   @default(now()) @map("assigned_at")

  @@id([roleId, permissionId])  // Composite PK
  @@map("role_permissions")
}

